#!/usr/bin/env bash
# On-demand backup of THIS installation (same format as the nightly "backup" service):
# backups/hrms-<timestamp>/{db.dump,documents.tar.gz,SHA256SUMS} inside the backups volume.
# Usage: bin/backup            then  bin/dc cp backup:/backups/hrms-<ts> ./   to copy it off the volume
set -euo pipefail
cd "$(dirname "$0")/.."
bin/dc exec -T backup /bin/sh /scripts/backup-loop.sh --now
bin/dc exec -T backup ls -1 /backups | grep '^hrms-' | tail -3

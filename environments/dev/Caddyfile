# Automatic HTTPS (Let's Encrypt) + same-origin routing for one installation.
# SITE_ADDRESS: hostname(s) from APP_URL / APP_EXTRA_DOMAINS, comma separated, e.g. "dev.example.com".
# DNS must point at this host and ports 80 + 443 must be reachable before the first start.

{$SITE_ADDRESS} {
	encode zstd gzip

	# The backend owns the API, health, readiness and branding files; it matches the Host header
	# against its configured domains, so Caddy keeps the original Host.
	@backend path /api/* /health /health/* /ready /branding/*
	handle @backend {
		reverse_proxy backend:4000
	}
	handle {
		reverse_proxy frontend:8080
	}

	header {
		>Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Optional: plain-HTTP addresses (e.g. the server IP) that redirect to APP_URL.
# CADDY_REDIRECT_ADDRESSES="http://203.0.113.10"; an unused placeholder when not set.
{$CADDY_REDIRECT_ADDRESSES:http://redirect.invalid} {
	redir {$APP_URL}{uri} permanent
}

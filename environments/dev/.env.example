# ============================================================================
# Dev installation (dev.rgrishabh.in). The deploy workflow writes this file on the host from the
# GitHub Environment secret DEV_ENV_FILE (mode 600). To create that secret:
#   cp .env.example .env && bin/init-env    # fills the secrets below
#   gh secret set DEV_ENV_FILE --env dev --repo rgrishabh/hrms-deployment < .env && rm .env
# Never commit .env. Values in <angle brackets> are placeholders.
# In .env files, QUOTE colours ("#14532D"): an unquoted # can be read as a comment.
# Image tags are NOT here: they live in versions.env (bot-managed).
# ============================================================================

# ---- Deployment -------------------------------------------------------------
COMPOSE_PROJECT_NAME=hrms-dev
APP_ENVIRONMENT=dev
APP_URL=https://dev.rgrishabh.in
# Extra hostnames for the same installation (comma separated), optional:
APP_EXTRA_DOMAINS=
# Caddy (automatic HTTPS): the hostname(s) above, comma separated
SITE_ADDRESS=dev.rgrishabh.in
# Optional: plain-HTTP addresses that redirect to APP_URL, e.g. the server IP: http://203.0.113.10
CADDY_REDIRECT_ADDRESSES=
LOG_LEVEL=info

# ---- Backups ----------------------------------------------------------------
# Nightly at BACKUP_AT (organization timezone) into the "backups" volume, kept BACKUP_KEEP_DAYS days.
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=7
# Off-host copy to S3 using the EC2 instance role: set both lines.
# COMPOSE_PROFILES=s3backup
# BACKUP_S3_URI=s3://<bucket>/hrms-dev
AWS_REGION=ap-south-1

# ---- Security -------------------------------------------------------------------
# Two-factor authentication minimum: privileged (admins, HR admins, payroll, IT) | all | off
MFA_ENFORCEMENT=privileged

# ---- Modules (deployment-controlled; restart to apply; data is never deleted) ----
# 'default' = core HR + attendance (web), regularization, shifts, holidays, leave, self-service.
# Add e.g. attendance.mobile, attendance.biometric. Unknown/unavailable modules stop startup.
ENABLED_MODULES=default,expenses,training,lab.competency,core.policies

# ---- Email (module notifications.email; add it to ENABLED_MODULES) ---------------
# disabled | smtp. Use your provider's SMTP relay (e.g. Amazon SES SMTP, Microsoft 365, Google Workspace).
MAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS (required) on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ---- SMS (module notifications.sms; add it to ENABLED_MODULES) -------------------
# disabled | http. Your SMS provider's send API; templates, sender ID and entity ID are registered on
# the operator's DLT platform (India). See the backend's docs/SMS.md for the body placeholders.
SMS_TRANSPORT=disabled
SMS_HTTP_URL=
# One header, "Name: value" (the provider's API key). Secret: keep this file private.
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_CONTENT_TYPE=json
SMS_HTTP_BODY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=

# ---- Documents (stored in this installation's app-storage volume) ----------------
STORAGE_MAX_FILE_MB=10

# ---- Branding (shown in UI, page title, documents) ----------------------------
PRODUCT_NAME=LabHRMS
BRAND_NAME=HRMS Dev
BRAND_SHORT_NAME=HRMS Dev
# https://... URL, or a file you place in ./branding/ referenced as /branding/<file>
# (svg, png, jpg, webp, ico; max 2 MB). Leave empty to show the brand initials.
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_PRIMARY_COLOR="#14532D"
BRAND_SECONDARY_COLOR="#0F172A"
BRAND_ACCENT_COLOR="#2E8B57"
BRAND_LOGIN_MESSAGE=
BRAND_SUPPORT_EMAIL=<support@rgrishabh.in>
BRAND_SUPPORT_PHONE=
BRAND_HELP_URL=

# ---- Organization identity ----------------------------------------------------
ORGANIZATION_NAME=HRMS Dev Laboratories
ORGANIZATION_LEGAL_NAME=HRMS Dev Laboratories (test data only)
ORGANIZATION_COUNTRY=IN
ORGANIZATION_TIMEZONE=Asia/Kolkata
ORGANIZATION_CURRENCY=INR
ORGANIZATION_DATE_FORMAT=DD-MM-YYYY
ORGANIZATION_FY_START_MONTH=4

# ---- First administrator (first deploy writes a one-time setup link to setup-link.txt on the host) ----
BOOTSTRAP_ADMIN_EMAIL=<admin@rgrishabh.in>
BOOTSTRAP_ADMIN_NAME=<Full Name>

# ---- Secrets: generated by bin/init-env. Do not reuse across customers. ----------
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DATA_ENCRYPTION_KEY=

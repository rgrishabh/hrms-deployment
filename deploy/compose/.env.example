# ============================================================================
# One customer installation. Copy this directory per customer, then:
#   cp .env.example .env && bin/init-env      (fills the secrets below, chmod 600)
# Never commit .env. Values in <angle brackets> are placeholders.
# In .env files, QUOTE colours ("#14532D"): an unquoted # can be read as a comment.
# ============================================================================

# ---- Deployment -------------------------------------------------------------
COMPOSE_PROJECT_NAME=hrms-<customer-slug>
HRMS_IMAGE=<registry>/labhrms:<version>
APP_URL=https://hrms.<customer-domain>
# Extra hostnames for the same installation (comma separated), optional:
APP_EXTRA_DOMAINS=
# Where the app listens on the VM (keep 127.0.0.1 behind a reverse proxy):
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# Proxy in front sets X-Forwarded-For (true for the bundled Caddy or most proxies):
TRUST_PROXY=true
LOG_LEVEL=info

# Optional bundled HTTPS (docker compose --profile https up -d):
CADDY_SITE_ADDRESSES=hrms.<customer-domain>
# Optional: plain-HTTP addresses that redirect to APP_URL, e.g. the server IP: http://203.0.113.10
CADDY_REDIRECT_ADDRESSES=

# ---- Security -------------------------------------------------------------------
# Two-factor authentication minimum: privileged (admins, HR admins, payroll, IT) | all | off
MFA_ENFORCEMENT=privileged

# ---- Modules (deployment-controlled; restart to apply; data is never deleted) ----
# 'default' = core HR + attendance (web), regularization, shifts, holidays, leave, self-service.
# Add e.g. attendance.mobile, attendance.biometric. Unknown/unavailable modules stop startup.
ENABLED_MODULES=default

# ---- Email (module notifications.email; add it to ENABLED_MODULES) ---------------
# disabled | smtp. Use your provider's SMTP relay (e.g. Amazon SES SMTP, Microsoft 365, Google Workspace).
MAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS (required) on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ---- Documents (stored in this installation's app-storage volume) ----------------
STORAGE_MAX_FILE_MB=10

# ---- Branding (shown in UI, page title, documents) ----------------------------
PRODUCT_NAME=LabHRMS
BRAND_NAME=<Customer A>
BRAND_SHORT_NAME=<Customer A HR>
# https://... URL, or a file you place in ./branding/ referenced as /branding/<file>
# (svg, png, jpg, webp, ico; max 2 MB). Leave empty to show the brand initials.
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_PRIMARY_COLOR="#14532D"
BRAND_SECONDARY_COLOR="#0F172A"
BRAND_ACCENT_COLOR="#2E8B57"
BRAND_LOGIN_MESSAGE=
BRAND_SUPPORT_EMAIL=<hr-support@customer-domain>
BRAND_SUPPORT_PHONE=
BRAND_HELP_URL=

# ---- Organization identity ----------------------------------------------------
ORGANIZATION_NAME=<Customer A Testing Laboratories>
ORGANIZATION_LEGAL_NAME=<Customer A Testing Laboratories Private Limited>
ORGANIZATION_COUNTRY=IN
ORGANIZATION_TIMEZONE=Asia/Kolkata
ORGANIZATION_CURRENCY=INR
ORGANIZATION_DATE_FORMAT=DD-MM-YYYY
ORGANIZATION_FY_START_MONTH=4

# ---- First administrator (bootstrap prints a one-time setup link) ---------------
BOOTSTRAP_ADMIN_EMAIL=<it-admin@customer-domain>
BOOTSTRAP_ADMIN_NAME=<Full Name>

# ---- Secrets: generated by bin/init-env. Do not reuse across customers. ----------
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DATA_ENCRYPTION_KEY=

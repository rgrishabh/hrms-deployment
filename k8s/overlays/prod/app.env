# Layer 1: settings for this installation (docs/CONFIGURATION.md). Restart to apply. No secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Proxies in front of the app: CloudFront and the ALB on mid and high, the ALB and Traefik on low.
TRUST_PROXY=2
RATE_LIMIT_PER_MINUTE=3000
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=10
EXPORT_RATE_LIMIT_PER_MINUTE=30
JOBS_INTERVAL_SECONDS=60
# For example http://collector:4318. Needs an egress rule on that port too. Empty sends no traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# PWA push. The private key is in hrms/runtime-optional.
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
COOKIE_SECURE=true
DATABASE_SSL=verify-full
SESSION_TTL_HOURS=12
ORG_MANAGEMENT_MODE=multi
MFA_AVAILABLE=true
MFA_ENFORCED=false
MFA_METHODS=totp,email
STORAGE_DRIVER=s3
STORAGE_MAX_FILE_MB=10
# For an S3-compatible store instead of AWS S3. Empty on AWS.
S3_ENDPOINT=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=starttls
FEATURE_DOCUMENTS=true
FEATURE_ONBOARDING=false
FEATURE_OFFBOARDING=false
FEATURE_POLICIES=false
FEATURE_ATTENDANCE=true
FEATURE_ATTENDANCE_WEB=true
FEATURE_ATTENDANCE_MOBILE=false
FEATURE_ATTENDANCE_GEOFENCE=false
FEATURE_ATTENDANCE_SELFIE=false
FEATURE_ATTENDANCE_BIOMETRIC=false
FEATURE_ATTENDANCE_REGULARIZATION=true
FEATURE_SHIFTS=true
FEATURE_HOLIDAYS=true
FEATURE_LEAVE=true
FEATURE_OVERTIME=false
FEATURE_COMP_OFF=false
FEATURE_FIELD_DUTY=false
FEATURE_PAYROLL=false
FEATURE_PAYSLIPS=false
FEATURE_PAYROLL_STATUTORY=false
FEATURE_LOANS=false
FEATURE_SALARY_ADVANCE=false
FEATURE_ACCOUNTING_EXPORTS=false
FEATURE_EXPENSE_CLAIMS=false
FEATURE_TRAVEL=false
FEATURE_RECRUITMENT=false
FEATURE_PERFORMANCE_REVIEW=false
FEATURE_TRAINING=false
FEATURE_LAB_COMPETENCY=false
FEATURE_ASSET_MANAGEMENT=false
FEATURE_GRIEVANCE=false
FEATURE_POSH=false
FEATURE_REPORTS_ADVANCED=false
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_PUSH_NOTIFICATIONS=false

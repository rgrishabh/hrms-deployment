# Customer installation settings (non-secret). Copy to customers/<customer-slug>.tfvars.
# Secrets are generated by Terraform into AWS Secrets Manager; never put them here.
account_id    = "<12-digit-customer-account-id>"
region        = "ap-south-1"
customer_slug = "<customer-slug>" # used for resource names/tags only
environment   = "production"

domains         = ["hrms.<customer-domain>"] # first = primary (APP_URL); others = APP_EXTRA_DOMAINS
route53_zone_id = null                       # set when we host the zone in this account; null = customer adds DNS records

# Modules for this installation (ENABLED_MODULES). Restart-free change = a new release via the pipeline.
enabled_modules = ["default"] # e.g. ["default", "attendance.biometric"]

organization = {
  name           = "<Customer A Testing Laboratories>"
  legal_name     = "<Customer A Testing Laboratories Private Limited>"
  country        = "IN"
  timezone       = "Asia/Kolkata"
  currency       = "INR"
  date_format    = "DD-MM-YYYY"
  fy_start_month = 4
}

branding = {
  product_name    = "LabHRMS"
  brand_name      = "<Customer A>"
  short_name      = "<Customer A HR>"
  logo_url        = null # https:// URL only on AWS
  favicon_url     = null
  primary_color   = "#14532D"
  secondary_color = "#0F172A"
  accent_color    = "#2E8B57"
  login_message   = null
  support_email   = "<hr-support@customer-domain>"
  support_phone   = null
  help_url        = null
}

# Email (add "notifications.email" to enabled_modules). The SMTP password goes into the secret
# hrms/smtp-password (aws secretsmanager put-secret-value), never here.
mail = {
  transport    = "disabled" # or "smtp"
  smtp_host    = null       # e.g. "email-smtp.ap-south-1.amazonaws.com"
  smtp_port    = 587
  smtp_user    = null
  from_address = null       # e.g. "hrms@customer-domain"
  from_name    = null
}

# SMS (add "notifications.sms" to enabled_modules). The provider's auth header ("Name: value") goes into
# the secret hrms/sms-auth-header (aws secretsmanager put-secret-value), never here. Templates are entered
# in HRMS (Settings → SMS) as registered on the operator's DLT platform.
sms = {
  transport     = "disabled" # or "http"
  http_url      = null       # the provider's https send endpoint
  content_type  = "json"     # or "form"
  body          = null       # see the backend's docs/SMS.md
  sender_id     = null       # DLT header
  dlt_entity_id = null
}

# First administrator: created by the bootstrap task on the first release; temporary password
# is in Secrets Manager (hrms/bootstrap-admin) and must be changed at first sign-in.
admin_email = "<it-admin@customer-domain>"
admin_name  = "<Full Name>"

# From the shared-services outputs.
backend_image  = "ghcr.io/rgrishabh/hrms-backend:v1.0.0"
frontend_image = "ghcr.io/rgrishabh/hrms-frontend:v1.0.0"

github_repository = "rgrishabh/hrms-deployment" # GitHub Environments infra-<slug> (Terraform) and prod-<slug> (deploys)

db_instance_class  = "db.t4g.medium"
db_multi_az        = true
nat_gateway_per_az = false
api_min_count      = 2
api_max_count      = 6

alarm_emails       = ["<ops-email>"]
monthly_budget_usd = 0 # set to get 80%/100% budget alerts

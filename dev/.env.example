# ============================================================================
# Layer 1 settings and secrets for one installation. Never commit .env.
#   cp .env.example .env && bin/init-env      fills the secrets below
# On the dev host this file is written from the GitHub secret DEV_ENV_FILE_V2 (mode 600).
# Brand and identity are not here: they live in .brandenv. Image tags live in versions.env.
# Values in <angle brackets> are placeholders. See docs/CONFIGURATION.md for each variable.
# ============================================================================

# ---- Deployment -------------------------------------------------------------
# local = plain HTTP on 127.0.0.1:HTTP_PORT; tls = Caddy on 80 and 443. Add minio, s3backup as needed.
COMPOSE_PROFILES=local
HTTP_PORT=8088
APP_ENVIRONMENT=dev
# development allows SMTP_SECURE=none (Mailpit). On-prem production: production, with real SMTP.
NODE_ENV=development
# Leave true behind Caddy. Safari refuses Secure cookies on http://localhost; set false only there.
COOKIE_SECURE=true
LOG_LEVEL=info

# ---- TLS profile ------------------------------------------------------------
# email for ACME expiry notices; recommended on any public host
CADDY_GLOBAL_OPTIONS=
# Empty = Let's Encrypt. "tls internal" = Caddy's private CA, for on-prem without public DNS.
CADDY_TLS=
# Plain-HTTP addresses that redirect to the main domain, for example http://203.0.113.10
CADDY_REDIRECT_ADDRESSES=

# ---- Backups ----------------------------------------------------------------
# Daily at BACKUP_AT in BACKUP_TZ into the "backups" volume, kept BACKUP_KEEP_DAYS days.
BACKUP_AT=02:30
BACKUP_TZ=Asia/Kolkata
BACKUP_KEEP_DAYS=7
BACKUP_MAX_AGE_HOURS=26
# Off-host copy, using the host's AWS role: add s3backup to COMPOSE_PROFILES and set this.
BACKUP_S3_URI=
AWS_REGION=ap-south-1

# ---- Modes and security -----------------------------------------------------
# single | single_hr | multi
ORG_MANAGEMENT_MODE=multi
MFA_AVAILABLE=false
MFA_ENFORCED=false
# Subset of totp,email. Leave empty when MFA_AVAILABLE=false.
MFA_METHODS=

# ---- Network and limits. Defaults are in docs/CONFIGURATION.md -------------
# Proxies in front of the app, counting Caddy. Add one for a load balancer in front of Caddy.
TRUST_PROXY=1
RATE_LIMIT_PER_MINUTE=3000
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=10
EXPORT_RATE_LIMIT_PER_MINUTE=30
JOBS_INTERVAL_SECONDS=60

# ---- Observability and optional services -----------------------------------
# For example http://collector:4318. Empty sends no traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# host or host:port of a read replica. Empty reads from the primary.
DB_READ_HOST=
# PWA push: base64url of raw P-256 keys, a pair, and a mailto: or https:// contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Features (only those differing from the registry defaults are needed) --
FEATURE_POLICIES=true
FEATURE_EXPENSE_CLAIMS=true
FEATURE_TRAINING=true
FEATURE_LAB_COMPETENCY=true

# ---- Email ------------------------------------------------------------------
# Mailpit catches everything in dev. Production: your provider, and SMTP_SECURE=starttls or tls.
SMTP_HOST=mailpit
SMTP_PORT=1025
# starttls | tls | none. Production refuses none.
SMTP_SECURE=none
SMTP_USER=
SMTP_PASSWORD=

# ---- Documents --------------------------------------------------------------
# local stores in the app-storage volume. s3 with the minio profile:
#   STORAGE_DRIVER=s3  S3_ENDPOINT=http://minio:9000  AWS_S3_BUCKET=hrms-documents
#   S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY, at least 8 and 16 characters
STORAGE_DRIVER=local
STORAGE_MAX_FILE_MB=10
AWS_S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- First administrator ----------------------------------------------------
# The first deploy writes a one-time setup link to setup-link.txt on the host.
BOOTSTRAP_ADMIN_EMAIL=<admin@example.com>
BOOTSTRAP_ADMIN_NAME=<Full Name>

# ---- Secrets: generated by bin/init-env. Do not reuse across installations. --
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
REDIS_PASSWORD=
DATA_ENCRYPTION_KEY=
# Bearer token for GET /metrics, reachable only inside the Docker network. Clear it to remove the route.
METRICS_TOKEN=

# ---- Key rotation only. Comma-separated older keys, while `hrms rotate-keys` runs; remove afterwards. --
DATA_ENCRYPTION_KEY_PREVIOUS=
# KMS instead of DATA_ENCRYPTION_KEY. On-prem installations leave these empty.
KMS_KEY_ID=
DATA_KEY_CIPHERTEXT=
DATA_KEY_CIPHERTEXT_PREVIOUS=
